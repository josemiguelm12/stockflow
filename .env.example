# Desarrollo local únicamente. Estos valores son públicos e inseguros para producción.
# Copie este archivo como .env y no versione el archivo resultante.
POSTGRES_DB=stockflow
POSTGRES_USER=stockflow_app
POSTGRES_PASSWORD=stockflow_dev_only_password

STOCKFLOW_APP_PORT=8080
STOCKFLOW_CORS_ALLOWED_ORIGINS=http://localhost:8080
STOCKFLOW_OUTBOX_ENCRYPTION_KEY=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
STOCKFLOW_OUTBOX_ENCRYPTION_KEY_ID=dev-key-1
STOCKFLOW_JWT_SECRET=enl4d3Z1dHNycXBvbm1sa2ppaGdmZWRjYmE5ODc2NTQ=

STOCKFLOW_PUBLIC_ACTIVATION_URL=http://localhost:8080/activate
STOCKFLOW_ACTIVATION_TOKEN_TTL=PT24H
STOCKFLOW_PUBLIC_PASSWORD_RESET_URL=http://localhost:8080/reset-password
STOCKFLOW_PASSWORD_RESET_TOKEN_TTL=PT30M
STOCKFLOW_RATE_LIMIT_GLOBAL_PER_MINUTE=120
STOCKFLOW_RATE_LIMIT_LOGIN_PER_MINUTE=10
STOCKFLOW_RATE_LIMIT_PASSWORD_FORGOT_PER_MINUTE=5
STOCKFLOW_RATE_LIMIT_PASSWORD_RESET_PER_MINUTE=10
STOCKFLOW_RATE_LIMIT_PASSWORD_CHANGE_PER_MINUTE=5

# El worker usa Mailpit únicamente dentro de la red Docker.
STOCKFLOW_SMTP_HOST=smtp
STOCKFLOW_SMTP_PORT=1025
STOCKFLOW_SMTP_USERNAME=
STOCKFLOW_SMTP_PASSWORD=
STOCKFLOW_SMTP_FROM=stockflow@example.test
STOCKFLOW_WORKER_INTERVAL_SECONDS=15

STOCKFLOW_DOCUMENTS_STORAGE_PATH=/var/lib/stockflow/documents
STOCKFLOW_DOCUMENTS_MAX_SIZE_BYTES=10485760

# Opcional: deje ambos vacíos para deshabilitar Mindee sin impedir el arranque.
STOCKFLOW_MINDEE_API_KEY=
STOCKFLOW_MINDEE_MODEL_ID=
STOCKFLOW_MINDEE_BASE_URL=https://api-v2.mindee.net
STOCKFLOW_MINDEE_TIMEOUT=PT20S
