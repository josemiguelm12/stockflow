# Plantilla de variables de entorno. Define estos nombres en tu entorno real; no pongas
# valores reales en este archivo ni subas un .env al repositorio.

# URL JDBC de PostgreSQL (jdbc:postgresql://host:puerto/base).
SPRING_DATASOURCE_URL=
# Usuario de PostgreSQL.
SPRING_DATASOURCE_USERNAME=
# Contraseña de PostgreSQL.
SPRING_DATASOURCE_PASSWORD=
# Orígenes del frontend permitidos por CORS, separados por comas. Sin comodín.
STOCKFLOW_CORS_ALLOWED_ORIGINS=
# Clave AES-256 del outbox: Base64 de exactamente 32 bytes (se usa desde T01).
STOCKFLOW_OUTBOX_ENCRYPTION_KEY=
# Identificador de la clave del outbox, para rotación (se usa desde T01).
STOCKFLOW_OUTBOX_ENCRYPTION_KEY_ID=

# URL pública de la landing de activación; el enlace del correo es esta URL + #token=...
# Ejemplo de forma: http://host:puerto/activate
STOCKFLOW_PUBLIC_ACTIVATION_URL=
# Vigencia del token de activación como duración ISO-8601 (por ejemplo PT24H).
STOCKFLOW_ACTIVATION_TOKEN_TTL=
# Servidor SMTP usado solo por el worker de correo.
STOCKFLOW_SMTP_HOST=
# Puerto SMTP (587 con STARTTLS, 465 con SSL).
STOCKFLOW_SMTP_PORT=
# Usuario SMTP (vacío si el servidor no exige autenticación).
STOCKFLOW_SMTP_USERNAME=
# Contraseña SMTP.
STOCKFLOW_SMTP_PASSWORD=
# Dirección remitente de los correos.
STOCKFLOW_SMTP_FROM=

# Secreto HMAC para firmar los JWT: Base64 de exactamente 32 bytes aleatorios (obligatorio).
STOCKFLOW_JWT_SECRET=
# Máximo de solicitudes por minuto y por IP a /api/v1/** (vacío = 120).
STOCKFLOW_RATE_LIMIT_GLOBAL_PER_MINUTE=
# Máximo de solicitudes por minuto y por IP a POST /api/v1/auth/login (vacío = 10).
STOCKFLOW_RATE_LIMIT_LOGIN_PER_MINUTE=
